# ==============================================================================
# Environment Configuration Template: Zomato AI Restaurant Recommender
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Groq LLM Inference Settings
# ------------------------------------------------------------------------------
# Obtain your free API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Recommended models:
#   - llama-3.3-70b-versatile  (Production default: superior reasoning & ranking)
#   - llama-3.1-8b-instant     (Development: faster, lower token latency)
GROQ_MODEL=llama-3.3-70b-versatile

# Temperature controls response creativity (0.0 to 2.0; 0.2 - 0.4 recommended for deterministic ranking)
GROQ_TEMPERATURE=0.3

# Maximum tokens for Groq reasoning and explanation response
GROQ_MAX_TOKENS=2048

# Maximum timeout in seconds before triggering automatic deterministic fallback
GROQ_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# Dataset & Caching Settings
# ------------------------------------------------------------------------------
# Hugging Face dataset identifier
HF_DATASET_NAME=ManikaSaini/zomato-restaurant-recommendation

# Local filesystem path for cached preprocessed Parquet dataset (<100ms load time)
DATASET_CACHE_PATH=./data/restaurants.parquet

# ------------------------------------------------------------------------------
# Candidate Generation & Filtering Rules
# ------------------------------------------------------------------------------
# Maximum candidates passed from filtering layer to LLM prompt (controls prompt budget)
MAX_CANDIDATES_FOR_LLM=30

# Budget tier upper bounds in INR (cost for two):
#   - Low:    <= BUDGET_LOW_MAX (default 500)
#   - Medium: BUDGET_LOW_MAX < cost <= BUDGET_MEDIUM_MAX (default 1500)
#   - High:   > BUDGET_MEDIUM_MAX
BUDGET_LOW_MAX=500
BUDGET_MEDIUM_MAX=1500

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
# Default number of top picks to return to the user (between 1 and 10)
TOP_K_DEFAULT=5

# Application log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
