# Streamlit Community Cloud Secrets Template
# In share.streamlit.io -> App Settings -> Secrets, paste your configuration:

GROQ_API_KEY = "gsk_your_groq_api_key_here"
GROQ_MODEL = "llama-3.3-70b-versatile"
HF_DATASET_NAME = "ManikaSaini/zomato-restaurant-recommendation"
DATASET_CACHE_PATH = "./data/restaurants.parquet"
LOG_LEVEL = "INFO"
